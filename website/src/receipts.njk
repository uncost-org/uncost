{#- show-more.js MUST load before keyword-filter.js. Both are deferred, so they
    run in document order: show-more registers its listener and pages the grid
    down first, then the filter's own start-up pass runs and re-announces, and
    show-more re-pages off that event. Reversed, the filter's start-up pass
    would un-hide every card with nothing listening to put the paging back. -#}
<script src="/js/show-more.js" defer></script>
<script src="/js/keyword-filter.js" defer></script>
