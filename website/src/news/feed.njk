---
permalink: "/news/feed.xml"
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>Uncost — News</title>
    <link>{{ site.origin }}/news/</link>
    <atom:link href="{{ site.origin }}/news/feed.xml" rel="self" type="application/rss+xml" />
    <description>News from the Uncost movement.</description>
    <language>en</language>
    {%- if news and news.length %}
    <lastBuildDate>{{ news[0].pubDate }}</lastBuildDate>
    {%- for item in news %}
    <item>
      <title>{{ item.title }}</title>
      <link>{{ site.origin }}/news/#{{ item.slug }}</link>
      <guid isPermaLink="false">uncost-news-{{ item.slug }}</guid>
      <pubDate>{{ item.pubDate }}</pubDate>
      <description><![CDATA[{{ item.body }}]]></description>
    </item>
    {%- endfor %}
    {%- endif %}
  </channel>
</rss>
