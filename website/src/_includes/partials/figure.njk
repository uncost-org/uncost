{#-
  Renders a cost-of-living statistic FROM the register (sources/register.csv via
  _data/register.js). The wrapping data-source="SRC-###" is what the content
  audit reads as the citation — a figure is "cited" only inside a registered
  data-source. Never hardcode a number on a page; pass a register row here.

  Usage:
    {% import "partials/figure.njk" as fig %}
    {{ fig.stat(register.byId["SRC-004"]) }}
    {{ fig.line(register.byId["SRC-021"]) }}   (compact, one-line variant)
-#}


{% macro line(row) -%}
<span class="rcpt-src" data-source="{{ row.source_id }}">{{ row.display_caption }} <span class="rcpt-src">({{ row.source_line }})</span></span>
{%- endmacro %}


{#-
  card(row) — THE figure card (R3). One treatment for every sourced statistic on
  the site: /receipts/ register, /case/ 2x2 and mechanism 2-up, the homepage
  stats, and the sector-dossier figure slot. Replaces the retired `.fact`.

  Structure, in order:
    .id     SRC id
    .fig    the display value, in coral
    .unit   the data period — this IS the figure's scope, so it is never
            repeated as a chip in the row below
    .claim  the caption, bold, echoing its own display value in the numeral's
            colour (register.js builds captionHtml and escapes it first)
    .foot   SOURCE eyebrow, publisher, linked title, then the chip row:
            CHECKED · PUBLISHED (only when the register has a year) · region ·
            confidence

  Wrap a run of these in <div class="cards"> — the grid supplies the ink frame
  and 2px dividers (R2) and the cream/cream2 checkerboard.
-#}
{% macro card(row) -%}
<div class="card" id="{{ row.source_id }}" data-source="{{ row.source_id }}">
  <div class="id">{{ row.source_id }}</div>
  <div class="fig">{{ row.display_value }}</div>
  <div class="unit">{{ row.data_period }}</div>
  <div class="claim">{{ row.captionHtml | safe }}</div>
  <div class="foot">
    <div class="src-eyebrow">Source</div>
    <div class="pub">{{ row.publisher }}</div>
    <div class="ttl">{% if row.url %}<a href="{{ row.url }}" target="_blank" rel="noopener">{{ row.publication_work }}</a>{% else %}{{ row.publication_work }}{% endif %}</div>
    <div class="row">
      <span class="m">Checked {{ row.last_checked }}</span>
      {% if row.publication_year %}<span class="m">Published {{ row.publication_year }}</span>{% endif %}
      <span class="m">{{ row.region }}</span>
      <span class="rcpt-conf rcpt-conf--{{ "confirmed" if row.confidence.startsWith("confirmed") else "estimate" }}">{{ "Confirmed" if row.confidence.startsWith("confirmed") else "Estimate" }}</span>
    </div>
  </div>
</div>
{%- endmacro %}
