{#-
  Mobile menu (accordion) + sticky pledge bar. Shown under 940px.

  The export's nav-drawer.html ships only the header row and the secondary
  links — under 940px the primary nav (.hd-nav) is display:none, so on the
  export's own pages a phone user cannot reach The Movement / The Case / The
  Projects / The Assembly at all. css/site.css fully specifies the missing
  accordion (.drawer-acc > button > .pm, .in, .in .dd-desc, .in a .ar/.plan) and
  js/ui.js drives it by that exact contract, so it is reconstructed here from
  the same _data/chrome.json the header uses. Flagged in the integration PR.
-#}
<div class="drawer" role="dialog" aria-modal="true" aria-label="Menu">
  <div class="drawer-hd">{% image "logos/logo-tight-light.png", "uncost.org", "8rem", [160, 320] %}<button class="drawer-x" type="button" aria-label="Close menu" data-drawer-close>&#10005;</button></div>
  {% for item in chrome.nav %}
  <div class="drawer-acc">
    <button type="button" data-acc aria-expanded="false">{{ item.label }}<span class="pm" aria-hidden="true">+</span></button>
    <div class="in">
      <p class="dd-desc">{{ item.desc }}</p>
      {% for link in item.links %}
      <a href="{{ link.url }}"{% if link.external %} target="_blank" rel="noopener"{% endif %}><span>{{ link.label }}{% if link.badge %}<span class="plan">{{ link.badge }}</span>{% endif %}</span><span class="ar" aria-hidden="true">&rarr;</span></a>
      {% endfor %}
    </div>
  </div>
  {% endfor %}
  <div class="drawer-sub">{% for link in chrome.navSecondary %}<a href="{{ link.url }}">{{ link.label }}</a>{% endfor %}</div>
</div>
<div class="pledgebar"><a href="/pledge/">Sign the Pledge</a></div>
