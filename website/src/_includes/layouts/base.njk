<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{#- The homepage is found by its URL. `home` cannot be used: _data/home.json
    makes it global data, truthy on every page, so every page used to get the
    tagline title. Every other page is "<its own title> · Uncost". -#}
{% set pageTitle = "Uncost — " + site.tagline if page.url == "/" else (title or "") + " · Uncost" %}
{% set pageDesc = description or site.description %}
{% set canonical = site.origin + (page.url | default("/")) %}
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ pageDesc }}">
{#- formFlow: a pledge-flow page (check-email, verify, resent, thanks) has nothing
    to act on while formsOpen is off, so it stays out of search until forms open. -#}
{% if noindex or (formFlow and not features.formsOpen) %}<meta name="robots" content="noindex">
{% else %}<link rel="canonical" href="{{ canonical }}">
{% endif %}<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:description" content="{{ pageDesc }}">
<meta property="og:url" content="{{ canonical }}">
<meta property="og:image" content="{{ site.origin + site.ogImage }}">
<meta property="og:image:alt" content="Uncost logo">
<meta property="og:locale" content="{{ site.locale }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ pageTitle }}">
<meta name="twitter:description" content="{{ pageDesc }}">
<meta name="twitter:image" content="{{ site.origin + site.ogImage }}">
<link rel="alternate" type="application/rss+xml" title="Uncost — News" href="{{ site.origin }}/news/feed.xml">
<link rel="alternate" type="application/rss+xml" title="Uncost — Cost Watch" href="{{ site.origin }}/news/cost-watch/feed.xml">
{#- The design export's four stylesheets, adopted byte-identically and loaded in
    the order the export requires. Do not add a fifth design stylesheet and do
    not reorder these: sections.css depends on cascade position. -#}
<link rel="stylesheet" href="/css/tokens.css">
<link rel="stylesheet" href="/css/components.css">
<link rel="stylesheet" href="/css/site.css">
<link rel="stylesheet" href="/css/sections.css">
{#- Build-integration shim only — no design values. See the file's header. -#}
<link rel="stylesheet" href="/css/integration.css">
<link rel="stylesheet" href="/css/integration-v43-gap.css">
<script src="/js/ui.js" defer></script>
</head>
<body data-page="{{ pageId }}"{% if updatesOff %} data-updates-off{% endif %}>
{% include "partials/header.njk" %}
<main{% if mainClass %} class="{{ mainClass }}"{% endif %} id="main">
{{ content | safe }}
</main>
{% include "partials/footer.njk" %}
{% include "partials/nav-drawer.njk" %}
{% include "partials/search.njk" %}
</body>
</html>
