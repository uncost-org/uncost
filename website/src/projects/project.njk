---
layout: layouts/base.njk
pagination:
  data: catalog.projects
  size: 1
  alias: project
  addAllPagesToCollections: true
permalink: "/projects/{{ project.slug }}/"
eleventyComputed:
  pageId: "projects-{{ project.slug }}"
  title: "{{ project.display | safe }} ({{ project.id }})"
  description: "{{ project.id }} — {{ project.display }}. Project brief; a draft pending independent review, not approved for build."
---
{#- Re-derived from the export's project page. Public-facing copy comes from
    _data/projectContent.js (UNP-82 v1 §5, founder-approved, one entry per
    project); structural fields still come from the repository's own dossier via
    _data/catalog.js. No field falls back to the export's unreviewed draft prose.
    Unlike the sector and policy templates, nothing regenerates this file from the
    export — rederive_collections.py covers the sectors index, sector.njk and
    policy.njk only. Edit it here; the copy itself lives in projectContent.js.
    Stage labels: every dossier is `status: draft`, so the chips read "Draft" +
    "Not approved for build". The export's "In development" is not carried
    forward — the dossiers contradict it. Per docs/CONTROL.md the badge rule is
    on rendered text, not class names, so .status--dev stays the treatment. -#}
{% set pc = projectContent[project.id] %}
{#- Related-sectors swatches. The export's project pages cycle a positional
    palette (slot 0/1/2), the same square the sector pages carry; it was lost
    when this template was re-derived and the buttons rendered a colourless
    .sq. Taken from the export's own project pages. -#}
{% set relSq = ["u-117 sq", "u-118 sq", "u-119 sq"] %}
<!-- SECTION: projects/human-essentials-dashboard.Project head -->
<header class="p-head" data-screen-label="Project head">
  <div class="breadcrumb"><a href="/">Uncost</a> &nbsp;/&nbsp; <a href="/projects/">Projects</a> &nbsp;/&nbsp; <span>{{ project.display }}</span></div>
  <div class="p-meta"><span class="pid">{{ project.id }}</span><span class="status status--dev">Draft</span><span class="status status--planned">Not approved for build</span></div>
  <h1>{{ project.display }}</h1>
  <p class="tagline">{{ pc.publicSummary }}</p>
</header>
<!-- SECTION: projects/human-essentials-dashboard.At a glance -->
<section class="u-124 blk" data-screen-label="At a glance">
{#- V20: one structure on all seven pages — PRJ-001's opener: eyebrow,
    headline, intro. PRJ-001 and PRJ-002 carry founder-approved copy (P6-copy).
    The other five carry the same three slots in projectContent.js, empty until
    approved copy arrives, and an empty slot renders NOTHING — no element, no
    [CONTENT NEEDED] marker, no fallback text. (Before V20 those five showed
    the export's plain "At a glance" eyebrow; that fallback is gone, because
    the eyebrow is one of the three slots.) -#}
{%- set op = pc.opener or {} %}
{%- set headline = op.h2 or "" %}
{%- if op.eyebrow %}
  <div class="eyebrow">{{ op.eyebrow }}</div>
{%- endif %}
{%- if headline %}
  <h2 class="sec">{{ headline }}</h2>
{%- endif %}
{%- if op.intro %}
  <p class="u-11 lead">{{ op.intro }}</p>
{%- endif %}
  <div class="grid3">
    <div><h2><i></i>What it targets</h2><p>{{ pc.atAGlance.targets | safe }}</p></div>
    <div><h2><i></i>The mechanism</h2><p>{{ pc.atAGlance.mechanism | safe }}</p></div>
    <div><h2><i></i>How it lowers costs</h2><p>{{ pc.atAGlance.costPath | safe }}</p></div>
  </div>
</section>
<!-- SECTION: projects/human-essentials-dashboard.Overview -->
<section class="blk blk--cream2" data-screen-label="Overview">
  <div class="eyebrow">Overview</div>
  <h2>What this brief <span class="u-1">covers</span>.</h2>
  <p class="lead">{{ pc.overview }}</p>
</section>
<!-- SECTION: projects/human-essentials-dashboard.Funding & status -->
<section class="blk" data-screen-label="Funding & status">
  <div class="eyebrow">Funding &amp; status</div>
  <h2><span class="u-1">Honest</span> about where this stands.</h2>
  <div class="fund">
    <div class="fh"><span>{{ project.id }} &mdash; {{ project.display }}</span><span class="u-115 status status--dev">Draft</span></div>
    <div class="fb">
      <p><b>Resourcing:</b> {{ project.resourcePosture }}</p>
      <p><b>Most useful support now:</b> {{ pc.support }}</p>
      <p><b>Reporting:</b> once funds move, spending on this project will be reported in <a href="/treasury/">The Treasury</a>, with an internal receipt and approval trail.</p>
    </div>
  </div>
</section>
<!-- SECTION: projects/human-essentials-dashboard.Related sectors -->
<section class="blk blk--cream2" data-screen-label="Related sectors">
  <div class="eyebrow">Related sectors</div>
  <h2>Where it applies <span class="u-1">first</span>.</h2>
  <p class="lead">{{ pc.relatedSectors }}</p>
  <div class="rel">{% for s in project.sectors %}<a href="/sectors/{{ s.slug }}/"><span class="{{ relSq[loop.index0 % relSq.length] }}"></span> {{ s.name }}</a>{% endfor %}<a class="{{ relatedSectors._allLink.linkClass }}" href="/sectors/"><span class="{{ relatedSectors._allLink.squareClass }}"></span> All 15 sectors &rarr;</a></div>
</section>
<!-- SECTION: projects/human-essentials-dashboard.Project CTA -->
<section class="u-122 blk blk--coral" data-screen-label="Project CTA">
  <h2 class="u-38">{{ pc.cta }}</h2>
  <div class="u-123">
    <a href="https://github.com/uncost-org/uncost" target="_blank" rel="noopener" class="u-btn u-btn--ink">Build on GitHub</a>
    <a href="/join/" class="u-btn u-btn--ghost">Take Part</a>
  </div>
</section>
