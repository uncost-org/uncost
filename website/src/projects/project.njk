---
layout: layouts/base.njk
pagination:
  data: catalog.projects
  size: 1
  alias: project
  addAllPagesToCollections: true
permalink: "/projects/{{ project.slug }}/"
eleventyComputed:
  pageId: "projects-{{ project.slug }}"
  title: "{{ project.display | safe }} ({{ project.id }})"
  description: "{{ project.id }} — {{ project.display }}. Project brief; a draft pending independent review, not approved for build."
---
{#- Re-derived from the export's project page. Fields come from the repository's
    own dossier via _data/catalog.js; a field the dossier lacks renders a visible
    [CONTENT NEEDED] rather than the export's unreviewed draft prose.
    Regenerate with tools/rederive_collections.py. -#}
{% from "partials/content-needed.njk" import block as gap, inline as gapInline %}
<!-- SECTION: projects/human-essentials-dashboard.Project head -->
<header class="p-head" data-screen-label="Project head">
  <div class="breadcrumb"><a href="/">Uncost</a> &nbsp;/&nbsp; <a href="/projects/">Projects</a> &nbsp;/&nbsp; <span>{{ project.display }}</span></div>
  <div class="p-meta"><span class="pid">{{ project.id }}</span><span class="status status--dev">In development</span><span class="status status--planned">Not approved for build</span></div>
  <h1>{{ project.display }}</h1>
  <p class="tagline">{% if project.publicSummary %}{{ project.publicSummary.split(". ")[0] }}.{% else %}{{ gapInline("project-tagline") }}{% endif %}</p>
</header>
<!-- SECTION: projects/human-essentials-dashboard.At a glance -->
<section class="u-124 blk" data-screen-label="At a glance">
  <div class="eyebrow">At a glance</div>
  <div class="grid3">
    <div><h2><i></i>What it targets</h2><p>{% if project.sections["the problem and the cost being reduced"] %}{{ project.sections["the problem and the cost being reduced"] }}{% else %}{{ gapInline("project-targets") }}{% endif %}</p></div>
    <div><h2><i></i>The mechanism</h2><p>{% if project.sections["how it works"] %}{{ project.sections["how it works"] }}{% else %}{{ gapInline("project-mechanism") }}{% endif %}</p></div>
    <div><h2><i></i>How it lowers costs</h2><p>{% if project.sections["what it is / what it is not"] %}{{ project.sections["what it is / what it is not"] }}{% else %}{{ gapInline("project-cost-path") }}{% endif %}</p></div>
  </div>
</section>
<!-- SECTION: projects/human-essentials-dashboard.Overview -->
<section class="blk blk--cream2" data-screen-label="Overview">
  <div class="eyebrow">Overview</div>
  <h2>What this brief covers.</h2>
  {% if project.publicSummary %}<p class="lead">{{ project.publicSummary }}</p>{% else %}{{ gap("project-public-summary") }}{% endif %}\n  </section>
<!-- SECTION: projects/human-essentials-dashboard.Funding & status -->
<section class="blk" data-screen-label="Funding & status">
  <div class="eyebrow">Funding &amp; status</div>
  <h2>Honest about where this stands.</h2>
  <div class="fund">
    <div class="fh"><span>{{ project.id }} &mdash; {{ project.display }}</span><span class="u-115 status status--dev">In development</span></div>
    <div class="fb">
      {% if project.resourcePosture %}<p><b>Resourcing:</b> {{ project.resourcePosture }}</p>{% else %}{{ gap("project-resource-posture") }}{% endif %}
      {{ gap("project-useful-support") }}
      <p><b>Reporting:</b> once funds move, spending on this project will be reported in <a href="/treasury/">The Treasury</a>, with an internal receipt and approval trail.</p>
    </div>
  </div>
</section>
<!-- SECTION: projects/human-essentials-dashboard.Related sectors -->
<section class="blk blk--cream2" data-screen-label="Related sectors">
  <div class="eyebrow">Related sectors</div>
  <h2>Where it applies first.</h2>
  <div class="rel">{% for s in project.sectors %}<a href="/sectors/{{ s.slug }}/"><span class="sq"></span> {{ s.name }}</a>{% endfor %}<a class="{{ relatedSectors._allLink.linkClass }}" href="/sectors/"><span class="{{ relatedSectors._allLink.squareClass }}"></span> All 15 sectors &rarr;</a></div>
</section>
<!-- SECTION: projects/human-essentials-dashboard.Project CTA -->
<section class="u-122 blk blk--coral" data-screen-label="Project CTA">
  <h2 class="u-38">Help build {{ project.display | lower }}.</h2>
  <div class="u-123">
    <a href="https://github.com/uncost-org/uncost" target="_blank" rel="noopener" class="u-btn u-btn--ink">Build on GitHub</a>
    <a href="/join/" class="u-btn u-btn--ghost">Take Part</a>
  </div>
</section>
